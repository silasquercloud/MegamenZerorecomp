# Keep reviewed submodule sources pristine; instrument build-local copies.
if(NOT DEFINED MMZ_NATIVE_ROOT)
    set(MMZ_NATIVE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/android/native")
endif()
foreach(name runtime host_window host_platform runtime_arm_default_aborts)
    file(READ "${GBARECOMP_ROOT}/src/runtime/${name}.cpp" code)
    set(code "#include \"${MMZ_NATIVE_ROOT}/boot-events.h\"\n#include \"${MMZ_NATIVE_ROOT}/enhanced.h\"\n${code}")
    if(name STREQUAL "runtime")
        string(REPLACE "runtime_init(&bus);" "runtime_init(&bus);\n    mmz_boot_event(\"MMZ_BOOT_07\", \"CPU/bus/dispatch recompilados inicializados\");" code "${code}")
        string(REPLACE "win.present(live_fb.data());" "{ mmz_simulation_frame(ppu.frame_count()); win.present(live_fb.data()); mmz_first_frame(ppu.frame_count()); }" code "${code}")
        string(REPLACE "bus.io().set_keyinput(ev.keyinput);" "bus.io().set_keyinput(ev.keyinput & ~mmz_touch_mask());" code "${code}")
        string(REPLACE "prev_exit_ns = t5;" "prev_exit_ns = t5;\n            mmz_phase(s.guest_us/1000.,s.render_us/1000.,s.audio_us/1000.,s.pump_us/1000.,s.pacer_us/1000.,s.present_us/1000.,self_heal_interpreted_insns(),self_heal_distinct_misses());" code "${code}")
    elseif(name STREQUAL "runtime_arm_default_aborts")
        string(REPLACE "extern \"C\" void runtime_dispatch_miss(uint32_t target_pc) {" "extern \"C\" void runtime_dispatch_miss(uint32_t target_pc) { MmzInterpreterScope mmz_interpreter_scope;" code "${code}")
    elseif(name STREQUAL "host_platform")
        string(REPLACE "std::chrono::microseconds(1200)" "std::chrono::microseconds(100)" code "${code}")
    else()
        string(REPLACE "auto* b = static_cast<Backend*>(impl_);\n    // Present-time" "if (!mmz_begin_present()) return;\n    auto* b = static_cast<Backend*>(impl_);\n    b->linear_filter = mmz_filter(b->linear_filter); b->pad_visible = false;\n    // Present-time" code "${code}")
        string(REPLACE "const PresentationLayout layout =\n        current_presentation_layout(b, &drawable_w, &drawable_h);" "PresentationLayout layout =\n        current_presentation_layout(b, &drawable_w, &drawable_h);\n    mmz_adjust_layout(drawable_w, drawable_h, layout.x, layout.y, layout.width, layout.height);" code "${code}")
        string(REPLACE "SDL_UpdateTexture(b->texture, nullptr, rgb888, b->base_w * 3);" "rgb888 = mmz_effects(rgb888,b->base_w,b->base_h);\n    if (mmz_vulkan_present(rgb888,b->base_w,b->base_h)) return;\n    mmz_gpu_metrics(0,0,0);\n    SDL_UpdateTexture(b->texture, nullptr, rgb888, b->base_w * 3);" code "${code}")
        string(REPLACE "SDL_RenderCopy(b->renderer, b->texture, nullptr, &destination);" "mmz_render_image(b->renderer, b->texture, destination, b->base_w, b->base_h, b->linear_filter);" code "${code}")
        string(REPLACE "// FPS readout (DisplayPerf hotkey): presents/sec, refreshed twice a" "mmz_end_present();\n    // FPS readout (DisplayPerf hotkey): presents/sec, refreshed twice a" code "${code}")
        string(REPLACE "b->cadence.dump();" "mmz_vulkan_close(); mmz_close_video(); b->cadence.dump();" code "${code}")
        string(REPLACE "auto* b = new Backend{};" "mmz_boot_event(\"MMZ_BOOT_06\", \"SDL VIDEO inicializado; áudio/controller verificados (erros acima)\");\n    auto* b = new Backend{};" code "${code}")
        string(REPLACE "SDL_RendererInfo info{};" "mmz_boot_event(\"MMZ_BOOT_08\", \"Janela e renderer SDL criados\");\n        SDL_RendererInfo info{};" code "${code}")
    endif()
    set(dest "${CMAKE_CURRENT_BINARY_DIR}/mmz_${name}.cpp")
    # Avoid touching output timestamps on no-op reconfigure.
    file(WRITE "${dest}.tmp" "${code}")
    configure_file("${dest}.tmp" "${dest}" COPYONLY)
    foreach(prop COMPILE_DEFINITIONS COMPILE_OPTIONS)
        get_source_file_property(value "${GBARECOMP_ROOT}/src/runtime/${name}.cpp" DIRECTORY "${GBARECOMP_ROOT}" ${prop})
        if(value)
            set_source_files_properties("${dest}" DIRECTORY "${GBARECOMP_ROOT}" PROPERTIES ${prop} "${value}")
        endif()
    endforeach()
    get_target_property(sources gbarecomp_runtime SOURCES)
    list(REMOVE_ITEM sources "src/runtime/${name}.cpp")
    list(APPEND sources "${dest}")
    set_property(TARGET gbarecomp_runtime PROPERTY SOURCES "${sources}")
endforeach()
target_include_directories(gbarecomp_runtime PRIVATE "${GBARECOMP_ROOT}/src/runtime")
