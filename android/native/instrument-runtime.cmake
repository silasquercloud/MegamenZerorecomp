# Keep reviewed submodule sources pristine; instrument build-local copies.
foreach(name runtime host_window)
    file(READ "${GBARECOMP_ROOT}/src/runtime/${name}.cpp" code)
    set(code "#include \"${CMAKE_CURRENT_SOURCE_DIR}/android/native/boot-events.h\"\n${code}")
    if(name STREQUAL "runtime")
        string(REPLACE "runtime_init(&bus);" "runtime_init(&bus);\n    mmz_boot_event(\"MMZ_BOOT_07\", \"CPU/bus/dispatch recompilados inicializados\");" code "${code}")
        string(REPLACE "win.present(live_fb.data());" "{ win.present(live_fb.data()); mmz_first_frame(ppu.frame_count()); }" code "${code}")
    else()
        string(REPLACE "auto* b = new Backend{};" "mmz_boot_event(\"MMZ_BOOT_06\", \"SDL VIDEO inicializado; áudio/controller verificados (erros acima)\");\n    auto* b = new Backend{};" code "${code}")
        string(REPLACE "SDL_RendererInfo info{};" "mmz_boot_event(\"MMZ_BOOT_08\", \"Janela e renderer SDL criados\");\n        SDL_RendererInfo info{};" code "${code}")
    endif()
    set(dest "${CMAKE_CURRENT_BINARY_DIR}/mmz_${name}.cpp")
    # Avoid touching output timestamps on no-op reconfigure.
    file(WRITE "${dest}.tmp" "${code}")
    configure_file("${dest}.tmp" "${dest}" COPYONLY)
    foreach(prop COMPILE_DEFINITIONS COMPILE_OPTIONS)
        get_source_file_property(value "${GBARECOMP_ROOT}/src/runtime/${name}.cpp" DIRECTORY "${GBARECOMP_ROOT}" ${prop})
        if(value)
            set_source_files_properties("${dest}" DIRECTORY "${GBARECOMP_ROOT}" PROPERTIES ${prop} "${value}")
        endif()
    endforeach()
    get_target_property(sources gbarecomp_runtime SOURCES)
    list(REMOVE_ITEM sources "src/runtime/${name}.cpp")
    list(APPEND sources "${dest}")
    set_property(TARGET gbarecomp_runtime PROPERTY SOURCES "${sources}")
endforeach()
target_include_directories(gbarecomp_runtime PRIVATE "${GBARECOMP_ROOT}/src/runtime")
